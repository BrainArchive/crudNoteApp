package templates 

templ Index() {
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<title>Hello, world!</title>
	<meta name="viewport" content="width=device-width,initial-scale=1" />
	<meta name="description" content="" />
	<link rel="stylesheet" type="text/css" href="./static/website/css/style.css" />
	<link rel="icon" href="favicon.png">
	<script type="module" src="./static/scripts/datastar.js"></script>
</head>

<body>
	<h1>Hello, world!</h1>
	<button data-on:click="@get('/notes')">load notes</button>
	<div id='notes'>test</div>
	<input data-bind="foo"/>
	<div data-text="$foo"></div>
	<button data-show="$foo != ''" style="display: none">save</button>

</body>

</html>
}
